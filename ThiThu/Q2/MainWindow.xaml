<Window x:Class="Q2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Q2"
        mc:Ignorable="d"
        Title="PRN212_Book" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search Section -->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Title:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox x:Name="txtSearchTitle" Width="150" Height="24" VerticalContentAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="Publisher:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox x:Name="txtSearchPublisher" Width="150" Height="24" VerticalContentAlignment="Center" Margin="0,0,10,0" />
            <Button x:Name="btnSearch" Content="Search" Width="90" Height="24" Click="btnSearch_Click" />
        </StackPanel>

        <!-- DataGrid Section -->
        <DataGrid x:Name="dgBooks"
                  Grid.Row="1"
                  Grid.Column="0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="dgBooks_SelectionChanged"
                  Margin="0,0,15,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="BookID" Binding="{Binding BookId}" Width="Auto" />
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="150" />
                <DataGridTextColumn Header="Publication Year" Binding="{Binding PublicationYear}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Edit Section -->
        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top">
            <TextBlock Text="BookId" Margin="0,0,0,4" />
            <TextBox x:Name="txtBookId" IsEnabled="False" IsReadOnly="True" Height="24" VerticalContentAlignment="Center" Margin="0,0,0,8" />

            <TextBlock Text="Title" Margin="0,0,0,4" />
            <TextBox x:Name="txtTitle" Height="24" VerticalContentAlignment="Center" Margin="0,0,0,8" />

            <TextBlock Text="Publisher" Margin="0,0,0,4" />
            <TextBox x:Name="txtPublisher" Height="24" VerticalContentAlignment="Center" Margin="0,0,0,8" />

            <TextBlock Text="Publication Year" Margin="0,0,0,4" />
            <TextBox x:Name="txtPublicationYear" Height="24" VerticalContentAlignment="Center" Margin="0,0,0,15" />

            <Button x:Name="btnSave" Content="Save Changes" Width="110" Height="28" HorizontalAlignment="Center" Click="btnSave_Click" />
        </StackPanel>
    </Grid>
</Window>
